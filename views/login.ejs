<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Wanderlust</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/icon.png">

    <style>
        .login-card {
            border-radius: 15px;
            overflow: hidden;
        }

        .login-btn {
            width: 100%;
            padding: 10px;
            font-weight: 600;
        }

        .welcome-icon {
            font-size: 3rem;
        }
    </style>

</head>
<body>

<%- include("includes/header") %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-sm-10">

            <div class="card shadow login-card">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <div class="welcome-icon">🏕️</div>
                        <h2 class="mt-2">Welcome Back</h2>
                        <p class="text-muted">
                            Sign in to continue your Wanderlust journey
                        </p>
                    </div>

                    <% if (typeof returnTo !== "undefined" && returnTo) { %>
                        <div class="alert alert-info">
                            Please log in to access the page you requested.
                        </div>
                    <% } %>

                    <form method="POST" action="/login">

                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input
                                type="text"
                                class="form-control"
                                id="username"
                                name="username"
                                placeholder="Enter your username"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>

                            <div class="input-group">
                                <input
                                    type="password"
                                    class="form-control"
                                    id="password"
                                    name="password"
                                    placeholder="Enter your password"
                                    required
                                >

                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()">👁</button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary login-btn">Login</button>

                    </form>
                    <hr>

                    <p class="text-center mb-0">
                        Don't have an account?
                        <a href="/register">Sign up</a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

<%- include("includes/footer") %>

<script>
    function togglePassword() {
        const password = document.getElementById("password");

        password.type =
            password.type === "password"
                ? "text"
                : "password";
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
```

</body>
</html>
